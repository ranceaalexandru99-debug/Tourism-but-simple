# Optional: enable real AI route generation via the Claude API.
#
# This key is read ONLY by the API server (server/index.js) — note the missing
# VITE_ prefix, which is what keeps Vite from inlining it into the client
# bundle. The browser never sees it: it POSTs to /api/generate-route instead.
#
# Start the server with:  npm run server        (http://localhost:8787)
# In dev, Vite proxies /api there automatically (see vite.config.js).
# Without a key the server answers 503 and the app falls back to its local
# engine — everything still works, just without AI-generated destinations.
ANTHROPIC_API_KEY=

# Optional server tuning:
#   PORT               API server port (default 8787)
#   RATE_LIMIT_PER_MIN Requests per IP per minute (default 10)
#   ALLOWED_ORIGINS    Comma-separated browser origins for CORS, e.g.
#                      "https://turismdarsimplu.app" — only needed when the API
#                      is deployed on a DIFFERENT origin than the web app.

# Optional: point the client at an API on another origin. Leave empty when the
# app and the API share a host (the normal setup).
VITE_API_BASE=

# ---------------------------------------------------------------------------
# Supabase Auth
# ---------------------------------------------------------------------------
# Client-side. Both are safe in the browser bundle: the URL is public and the
# publishable (anon) key only grants what Row Level Security allows. Without
# them the app still runs — sign-in is simply disabled and guest mode works.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side ONLY — required for POST /api/delete-account.
#
# Deleting a user needs Supabase's admin API, which the browser cannot call.
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security completely: anyone
# holding it has full read/write access to your database. Never give it a VITE_
# prefix, never commit it, never send it to a client. Without these two the
# delete endpoint answers 503 and in-app account deletion won't work — which
# both app stores require, so set them before publishing.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: production error reporting (src/monitor.js). Leave empty to keep
# monitoring fully OFF (the default). If set, uncaught errors are POSTed there
# as small JSON payloads — and you must (1) allow the origin in the CSP
# connect-src (public/_headers + vercel.json) and (2) disclose it in the
# Privacy Policy.
VITE_ERROR_ENDPOINT=
