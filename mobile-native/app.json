{
  "expo": {
    "name": "Turism, dar simplu!",
    "slug": "turism-dar-simplu",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBFAF7",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.turismdarsimplu.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Turism, dar simplu! uses the camera so you can photograph the attractions you visit and add them to your trip gallery.",
        "NSPhotoLibraryUsageDescription": "Turism, dar simplu! lets you pick photos from your library to add to your trip gallery."
      }
    },
    "android": {
      "package": "com.turismdarsimplu.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBFAF7"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Turism, dar simplu! uses the camera to photograph attractions for your trip gallery.",
          "microphonePermission": false,
          "photosPermission": false
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#FBFAF7",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "revenueCatAndroidKey": "",
      "revenueCatIosKey": "",
      "errorEndpoint": ""
    }
  }
}
