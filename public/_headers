# Security headers for static hosts that read a _headers file
# (Netlify, Cloudflare Pages). Vite copies this file into dist/ on build.
# For Vercel, the equivalent lives in vercel.json.
#
# CSP note: style-src keeps 'unsafe-inline' because the app uses React inline
# styles (style attributes), which cannot be nonce'd. script-src is strict
# 'self' — there are no inline scripts (the no-flash script is /noflash.js and
# the PWA registers via an external script).
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; manifest-src 'self'; worker-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://upload.wikimedia.org https://commons.wikimedia.org https://*.basemaps.cartocdn.com; connect-src 'self' https://api.open-meteo.com https://nominatim.openstreetmap.org https://*.wikipedia.org https://commons.wikimedia.org https://overpass-api.de https://maps.mail.ru https://overpass.kumi.systems; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(self), camera=(self), microphone=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
